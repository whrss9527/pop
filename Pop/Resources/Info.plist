<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
		<string>en</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Pop</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pop</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>PopBuildID</key>
	<string>$(POP_BUILD_ID)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSAppleEventsUsageDescription</key>
	<string>在「系统操作」里切换深色、浅色模式时，要请「System Events」改系统的外观设置。</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>用「蓝牙设备」连接、断开配对过的耳机、键盘、鼠标时需要蓝牙权限。Pop 不会搜索或者配对新设备。</string>
	<key>NSCameraUsageDescription</key>
	<string>打开「摄像头小窗」时才会用到摄像头，在屏幕角落显示你自己；Pop 不会单独保存或上传摄像头的画面。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>用「录音」或者录屏时选了「麦克风」才会用到麦克风，录下你说的话。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>把录音、视频里说的话转成文字时需要语音识别权限。这台 Mac 支持时只在本机识别，不上传音频。</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>把选中的事情加到「提醒事项」时需要这个权限。Pop 只在你点「加到提醒事项」时添加一条提醒。</string>
	<key>NSRemindersUsageDescription</key>
	<string>把选中的事情加到「提醒事项」时需要这个权限。Pop 只在你点「加到提醒事项」时添加一条提醒。</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>把选中的事情加到「日历」时需要这个权限。Pop 只添加日程，不会读取你的日历。</string>
	<key>NSCalendarsUsageDescription</key>
	<string>把选中的事情加到「日历」时需要这个权限。Pop 只添加日程，不会读取你的日历。</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 whrss9527</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
