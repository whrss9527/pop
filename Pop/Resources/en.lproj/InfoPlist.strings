/* Info.plist 里给用户看的文字（系统弹出授权提示时显示） */
"NSRemindersFullAccessUsageDescription" = "Pop needs this to add the selected text to Reminders. It only adds a reminder when you click Add to Reminders.";
"NSRemindersUsageDescription" = "Pop needs this to add the selected text to Reminders. It only adds a reminder when you click Add to Reminders.";
"NSCalendarsWriteOnlyAccessUsageDescription" = "Pop needs this to add the selected text to Calendar. It only adds events and never reads your calendars.";
"NSCalendarsFullAccessUsageDescription" = "Pop needs to read your calendars to list upcoming events and remind you before meetings in Meeting Reminder. Events stay on this Mac and are never uploaded.";
"NSCalendarsUsageDescription" = "Pop needs this to add the selected text to Calendar and to list upcoming events in Meeting Reminder. Events stay on this Mac and are never uploaded.";
"NSSpeechRecognitionUsageDescription" = "Pop needs speech recognition to turn speech in recordings and videos into text. When this Mac supports it, recognition happens on the Mac and no audio is uploaded.";
"NSMicrophoneUsageDescription" = "Pop uses the microphone only when you use Voice Recorder or choose Microphone for a screen recording, to record what you say.";
"NSAppleEventsUsageDescription" = "Pop asks Finder or System Events for help to read the files selected in Finder and its open folder, to switch between Dark and Light Mode in System Actions or Dark Mode Schedule, and to shut down when Sleep Timer is up.";
"NSCameraUsageDescription" = "Pop uses the camera only when you open Camera Bubble, to show you in a small window on the screen. Pop doesn’t save or upload the camera picture on its own.";
"NSBluetoothAlwaysUsageDescription" = "Pop needs Bluetooth access when you connect or disconnect paired headphones, keyboards and mice in Bluetooth Devices. Pop doesn’t search for or pair new devices.";
