<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 英文的单复数（数量是 1 时用单数）。由 Localizable.strings 里同一条的英文加上单数形式得到；没列在这里的照 Localizable.strings -->
<plist version="1.0">
<dict>
	<key> %lld 天</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string> %#@n1@</string>
		<key>n1</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld day</string>
			<key>other</key>
			<string>%lld days</string>
		</dict>
	</dict>
	<key> · %lld 天后</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string> · in %#@n1@</string>
		<key>n1</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld day</string>
			<key>other</key>
			<string>%lld days</string>
		</dict>
	</dict>
