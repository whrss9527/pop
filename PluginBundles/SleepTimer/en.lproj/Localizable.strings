/* 定时睡眠：单独发布的插件包，界面文字的翻译放在它自己这里 */
"定时睡眠" = "Sleep Timer";
"过一会儿（15 分钟到 2 小时）或者到几点让 Mac 睡眠、熄屏、锁屏或者关机；最后一分钟在屏幕上方提示，可以推迟、取消，睡眠、关机前慢慢把音量调小" = "Put your Mac to sleep, turn off the display, lock the screen or shut down after a while (15 minutes to 2 hours) or at a set time. In the last minute a note at the top of the screen lets you postpone or cancel, and the volume fades out before sleep or shutdown";
"睡眠" = "Sleep";
"熄屏" = "Display Off";
"锁屏" = "Lock";
"关机" = "Shut Down";
"%@ 睡眠" = "Sleep at %@";
"%@ 熄屏" = "Display off at %@";
"%@ 锁屏" = "Lock at %@";
"%@ 关机" = "Shut down at %@";
"%@ 后睡眠" = "Sleeping in %@";
"%@ 后熄屏" = "Display off in %@";
"%@ 后锁屏" = "Locking in %@";
"%@ 后关机" = "Shutting down in %@";
"没能关机：%@" = "Couldn’t shut down: %@";
"没能关机" = "Couldn’t shut down";
"定时睡眠没做成" = "Sleep Timer couldn’t finish";
"要先在「系统设置 → 隐私与安全性 → 自动化」里允许 Pop 控制「System Events」" = "Allow Pop to control System Events in System Settings → Privacy & Security → Automation first";
"到点前一分钟在屏幕上方提示，可以推迟、取消。关机时有没存的文稿，App 会照常问，可能关不成。" = "A minute before, a note at the top of the screen lets you postpone or cancel. When shutting down, apps with unsaved documents still ask, which can stop the shutdown.";
"完成" = "Done";
"到点以后" = "When time’s up";
"多久以后" = "In";
"或者到" = "Or at";
"开始" = "Start";
"最后一分钟慢慢调小音量（睡眠、关机时）" = "Fade out the volume in the last minute (sleep and shut down)";
"推迟 %@ 分钟" = "Postpone %@ min";
"取消定时" = "Cancel Timer";
"取消" = "Cancel";
"没存的文稿 App 会问" = "Apps with unsaved documents will ask";
"正在慢慢调小音量" = "Fading out the volume";
"不用的话点「取消」" = "Click Cancel if you don’t need it";
