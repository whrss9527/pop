# Xcode 工程由 XcodeGen 生成（project.yml），不入库
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
.build/
build/
*.xcarchive
# scripts/build-app-store.sh 打出来的 App Store 安装包
dist/

# 本地签名配置（Team ID 等），模板见 Config/Local.xcconfig.example
Config/Local.xcconfig

# 签名证书和私钥（scripts/create-signing-certificate.sh 默认放在 ~/.pop-signing），千万不要提交
*.p12
*.p12.base64
*.p8
.pop-signing/

.DS_Store
__pycache__/
